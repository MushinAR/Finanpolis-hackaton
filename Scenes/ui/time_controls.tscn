[gd_scene format=3]

[ext_resource type="Script" path="res://Scripts/ui/time_controls.gd" id="1_time"]
[ext_resource type="FontFile" path="res://Assets/fonts/Poppins-Regular.ttf" id="2_medium"]
[ext_resource type="FontFile" path="res://Assets/fonts/Poppins-Regular.ttf" id="3_regular"]

[sub_resource type="StyleBoxFlat" id="StyleBoxFlat_group"]
content_margin_left = 3.0
content_margin_top = 3.0
content_margin_right = 3.0
content_margin_bottom = 3.0
bg_color = Color(0.969, 0.961, 0.949, 1)
border_width_left = 1
border_width_top = 1
border_width_right = 1
border_width_bottom = 1
border_color = Color(0.541, 0.541, 0.541, 1)
corner_radius_top_left = 10
corner_radius_top_right = 10
corner_radius_bottom_right = 10
corner_radius_bottom_left = 10
anti_aliasing = true

[sub_resource type="StyleBoxEmpty" id="StyleBoxEmpty_plain"]

[sub_resource type="StyleBoxFlat" id="StyleBoxFlat_selected"]
bg_color = Color(0.231, 0.51, 0.769, 1)
corner_radius_top_left = 6
corner_radius_top_right = 6
corner_radius_bottom_right = 6
corner_radius_bottom_left = 6
anti_aliasing = true

[node name="TimeControls" type="HBoxContainer"]
theme_override_constants/separation = 14
script = ExtResource("1_time")

[node name="Selector" type="PanelContainer" parent="."]
size_flags_vertical = 4
theme_override_styles/panel = SubResource("StyleBoxFlat_group")

[node name="Speeds" type="HBoxContainer" parent="Selector"]
unique_name_in_owner = true
theme_override_constants/separation = 0

[node name="Speed1" type="Button" parent="Selector/Speeds"]
